# Testnet stack (compose project: nimble-test) for testnet.nimble.* subdomain.
APP_PORT=3002
NIMIQ_NETWORK=TestAlbatross
# Balance pre-check on the payer's approval sheet. Leave unset to use the
# default for this network (https://rpc-testnet.nimiqscan.com); the check is advisory,
# so an unreachable RPC never blocks a payment.
#NIMIQ_RPC_URL=https://rpc-testnet.nimiqscan.com
DB_PASSWORD=<openssl rand -hex 24>
JWT_SECRET=<openssl rand -hex 32>
CODE_PEPPER=<openssl rand -hex 32>

# Shown in the wallet when it asks the user to sign in, so they can see which
# site is asking. Must match the domain users actually open — which for BOTH
# stacks is the same one: a single domain serves mainnet and testnet behind
# /api/main and /api/test (see apps/web/src/lib/network.ts). There is no
# separate testnet subdomain, so do not invent one here.
APP_ORIGIN=nimble.gallareton.pl
REMOTE_ORDERING_ENABLED=0

# USDT support uses Polygon MAINNET (137), even beside a Nimiq testnet stack.
# Leave unset for NIM-only testing. No mock ERC20 is treated as real USDT.
# POLYGON_RPC_URL=https://your-verified-polygon-mainnet-rpc
NOTIFICATIONS_ENABLED=false
NOTIFICATION_NETWORK_ID=5
NOTIFICATION_DAILY_BUDGET_LUNA=1000
NOTIFICATION_FEE_LUNA=0
NOTIFICATION_MAX_PER_MINUTE=10
# NOTIFICATION_PRIVATE_KEY_HEX=<dedicated unfunded/testnet operator key>
# NOTIFICATION_SENDER_ADDRESS=<address derived from that key>
# NOTIFICATION_RPC_URL=<matching Nimiq testnet RPC>

# Enable only with verified history-capable RPC endpoints.
WALLET_DISCOVERY_ENABLED=0

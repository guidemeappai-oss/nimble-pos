# Mainnet stack (compose project: nimble-main). Copy to .env.main and fill in
# FRESH secrets — never reuse the testnet ones.
APP_PORT=3003
NIMIQ_NETWORK=MainAlbatross
# Balance pre-check on the payer's approval sheet. Leave unset to use the
# default for this network (https://rpc-mainnet.nimiqscan.com); the check is advisory,
# so an unreachable RPC never blocks a payment.
#NIMIQ_RPC_URL=https://rpc-mainnet.nimiqscan.com
DB_PASSWORD=<openssl rand -hex 24>
JWT_SECRET=<openssl rand -hex 32>
CODE_PEPPER=<openssl rand -hex 32>

# Shown in the wallet when it asks the user to sign in, so they can see which
# site is asking. Must match the domain users actually open.
APP_ORIGIN=nimble.gallareton.pl
REMOTE_ORDERING_ENABLED=0

# Merchant USDT: configure a Polygon mainnet RPC (chain ID 137).
# POLYGON_RPC_URL=https://your-verified-polygon-rpc
# Optional readiness signals funded by a separate operator wallet.
NOTIFICATIONS_ENABLED=false
NOTIFICATION_NETWORK_ID=24
NOTIFICATION_DAILY_BUDGET_LUNA=1000
NOTIFICATION_FEE_LUNA=0
NOTIFICATION_MAX_PER_MINUTE=10
# NOTIFICATION_PRIVATE_KEY_HEX=<dedicated operator key; never an owner key>
# NOTIFICATION_SENDER_ADDRESS=<address derived from that dedicated key>
# NOTIFICATION_RPC_URL=<matching Nimiq mainnet RPC>

# Enable only with verified history-capable RPC endpoints.
WALLET_DISCOVERY_ENABLED=0
